# Dockerfile for SPOE mirror agent
# Python-based SPOE agent for request mirroring using the haproxyspoa library.

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        netcat-openbsd \
        net-tools \
        procps \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir haproxyspoa==0.0.1

COPY spoa_mirror.py /usr/local/bin/spoa-mirror
RUN chmod +x /usr/local/bin/spoa-mirror

# Run as non-root user
RUN useradd -r -s /bin/false spoa
USER spoa

EXPOSE 12345 12346

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:12346/health || exit 1

ENTRYPOINT ["python3", "-u", "/usr/local/bin/spoa-mirror"]
CMD ["-p", "12345", "-e", "12346", "-u", "http://backend-shadow:8080"]
